+static int ov13850_parse_endpoint(struct device *dev, struct ov13850 *sensor)
+{
+	struct v4l2_fwnode_endpoint cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "Missing CSI-2 endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_parse(endpoint, &cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "Invalid CSI-2 endpoint\n");
+
+	if (cfg.bus.mipi_csi2.num_data_lanes < OV13850_LANES)
+		return dev_err_probe(dev, -EINVAL, "OV13850 requires two routed CSI-2 lanes\n");
+
+	/* The ATK board routes four lanes. The stock register tables enable two. */
+	sensor->csi2 = cfg.bus.mipi_csi2;
+	sensor->csi2.num_data_lanes = OV13850_LANES;
+	return 0;
 }
 
